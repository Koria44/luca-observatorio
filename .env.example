# ==============================================================================
# Variables de entorno — Luca (Observatorio de Precios · Pedro Aguirre Cerda)
# Copiar a `.env` y completar con valores reales. NUNCA subir `.env` a Git.
# ==============================================================================

# Django básico
SECRET_KEY=cambiar-por-clave-secreta-larga-y-aleatoria-de-al-menos-50-caracteres
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Base de datos (si se deja vacío en local, usa SQLite automáticamente)
# Producción en Vercel: usar Supabase Transaction Pooler (puerto 6543) con sslmode=require
# Migraciones desde local: usar conexión directa o Session Pooler (puerto 5432)
DATABASE_URL=

# Supabase y almacenamiento S3-compatible (requerido en producción; disco Vercel es solo lectura)
SUPABASE_URL=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_KEY=
SUPABASE_S3_SECRET=
SUPABASE_BUCKET=luca-archivos
SUPABASE_BUCKET_PUBLICO=luca-publico
SUPABASE_BUCKET_PENDIENTES=luca-pendientes

# Mapas y geocodificación (MapLibre GL JS + Geoapify — plan gratuito sin tarjeta)
# NUNCA commitear valores reales ni exponer GEOAPIFY_KEY_SERVIDOR al navegador.
PROVEEDOR_MAPAS=geoapify
GEOAPIFY_KEY_NAVEGADOR=
GEOAPIFY_KEY_SERVIDOR=
GEOAPIFY_ESTILO=osm-bright
GEO_TOPE_DIARIO_PROXY=1500

# Correo electrónico (en local usa consola por defecto)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-responder@luca-pac.cl

# Seguridad de tareas programadas (Vercel Cron para expirar ofertas)
CRON_SECRET=cambiar-por-token-aleatorio-para-cron

# Modo demostración (habilita comando cargar_datos_demo y contraseñas locales)
DEMO_MODE=True
DEMO_PASSWORD_ADMIN=LucaAdmin2026!
DEMO_PASSWORD_FISCALIZADOR=LucaFiscal2026!
DEMO_PASSWORD_COMERCIANTE=LucaComercio2026!
DEMO_PASSWORD_VECINO=LucaVecino2026!

# Control de sesión (tolerancia de latido en segundos)
LATIDO_TOLERANCIA_STAFF=300
LATIDO_TOLERANCIA_PUBLICO=900
